# Copy to deploy/.env on the SERVER and fill in. Never commit the result:
# .gitignore already excludes it, and these five values together are full
# control of the application and every student record in it.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Generate each secret separately, on the server, and do not paste them into
# chat, a ticket or a terminal you are sharing:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# token_urlsafe emits only letters, digits, - and _, which matters for the
# database password: it goes into a URL, so a value containing @ : / or ?
# would silently truncate the connection string instead of failing loudly.

# --- Public identity ------------------------------------------------------
# The domain students type. It must already have an A record pointing at
# this server before the first deploy, or Caddy cannot get a certificate.
# No scheme, no trailing slash.
MESS_DOMAIN=mess.example.edu

# Where Let's Encrypt sends expiry warnings. Use an address someone reads.
ACME_EMAIL=you@example.edu

# --- Database -------------------------------------------------------------
# Only used by the containers on this box; Postgres publishes no host port.
POSTGRES_USER=cusat_mess
POSTGRES_PASSWORD=
POSTGRES_DB=cusat_mess_db

# --- Application secrets --------------------------------------------------
# Two separate secrets on purpose: a leaked QR key must not also be able to
# mint session tokens. config.py refuses to start in production if either is
# shorter than 32 characters or if the two are equal.
#
# If you are restoring a database from the old DigitalOcean app, carry the
# OLD values across rather than generating new ones -- a new JWT key logs
# every student out, and a new QR key invalidates codes mid-meal.
JWT_SECRET_KEY=
QR_SECRET_KEY=

# --- Tunables (safe to leave alone) ---------------------------------------
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_VALIDITY_SECONDS=60
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Backups --------------------------------------------------------------
# Where nightly dumps are written on this server. bootstrap.sh creates it.
BACKUP_DIR=/var/backups/messconnect
# How many nightly dumps to keep locally.
BACKUP_KEEP=14
#
# An rclone remote that backup.sh copies each dump to, e.g.
# "gdrive:messconnect-backups". LEAVING THIS EMPTY IS THE FAILURE THAT
# ALREADY HAPPENED ONCE: in November 2026 the DigitalOcean app and its
# database were destroyed for an unpaid invoice, and there was no copy of
# the data anywhere except on the thing that got destroyed. A backup that
# lives only on the server it backs up is not a backup.
BACKUP_OFFSITE_REMOTE=
