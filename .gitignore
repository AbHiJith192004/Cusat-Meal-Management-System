# Secrets — docker-compose.yml reads these at runtime, they are never inlined.
.env
.env.*
!.env.example
!.env.docker.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Local databases
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
dist/
build/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local production-audit tooling and generated evidence
/audit/
/.audit-private/
/.audit-venv/
ops/backups/

# Alert destinations, filled in locally. The Slack webhook URL in it is a
# credential -- anyone holding it can post into the channel -- and this repo
# is public. The committed template is ops/alert-destinations.example.yaml.
ops/alert-destinations.yaml
