# Database
DATABASE_URL=postgresql+asyncpg://cusat_mess:devpassword123@localhost:5432/cusat_mess_db
TEST_DATABASE_URL=postgresql+asyncpg://cusat_mess:devpassword123@localhost:5432/cusat_mess_test

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# QR
QR_SECRET_KEY=change-me-qr-secret-use-a-different-key
QR_VALIDITY_SECONDS=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# App
APP_ENV=development
LOG_LEVEL=INFO
