# Docker Production Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Connection (PostgreSQL Docker container)
DATABASE_URL=postgresql+asyncpg://cusat_mess:devpassword123@db:5432/cusat_mess_db

# Security & JWT Secrets
