# Copy to .env beside docker-compose.yml and fill in real values.
# The .env file itself must never be committed - see .gitignore.
#
# Generate the two secrets with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database -------------------------------------------------------------
POSTGRES_USER=cusat_mess
POSTGRES_PASSWORD=          # required, use a generated value
POSTGRES_DB=cusat_mess_db

# --- Application secrets --------------------------------------------------
# Two separate secrets on purpose: a leaked QR key must not also mint
# session tokens.
JWT_SECRET_KEY=             # required, generated
QR_SECRET_KEY=              # required, generated

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_VALIDITY_SECONDS=60

# --- Environment ----------------------------------------------------------
# Anything other than "development" turns on the Secure cookie flag and the
# tighter production rate limits.
APP_ENV=production
LOG_LEVEL=INFO

# --- Auth hardening -------------------------------------------------------
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- CORS -----------------------------------------------------------------
# Comma-separated exact origins. Never a wildcard: allow_credentials is on,
# so any origin listed here can read authenticated responses.
CORS_ORIGINS=https://mess.example.edu

# --- Frontend -------------------------------------------------------------
VITE_API_BASE_URL=https://mess.example.edu/api/v1
